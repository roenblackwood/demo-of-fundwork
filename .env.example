# Server key for the optional guide rewrite. Never put this in the browser.
XAI_API_KEY=
# Model id for that rewrite. See https://docs.x.ai.
FUNDWORK_AI_MODEL=
# Set to on to ask the server for a rewrite. Leave unset to use the template.
NEXT_PUBLIC_FUNDWORK_AI=
# Supabase project URL. Leave blank to keep the demo on this phone.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Safe in the browser. Leave blank to keep the demo on this phone.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key. Seed script only. Never put this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
